	urldate = {2025-06-11},
	journal = {Plants, People, Planet,},
	author = {Gallagher, Rachael V. and Allen, Stuart P. and Govaerts, Rafaël and Rivers, Malin C. and Allen, Andrew P. and Keith, David A. and Merow, Cory and Maitner, Brian and Butt, Nathalie and Auld, Tony D. and Enquist, Brian J. and Eiserhardt, Wolf L. and Wright, Ian J. and Mifsud, Jonathon C. O. and Espinosa-Ruiz, Silvia and Possingham, Hugh and Adams, Vanessa M.},
	month = nov,
