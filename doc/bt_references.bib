@article{shinMultispectraltoRGBKnowledgeDistillation2023,
	title = {Multispectral-to-{RGB} knowledge distillation for remote sensing image scene classification},
	volume = {20},
	copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
	issn = {1558-0571},
	url = {https://ieeexplore.ieee.org/document/10044685/},
	doi = {10.1109/LGRS.2023.3245095},
	abstract = {Scene classification is a fundamental task in the remote sensing (RS) field, assigning semantic labels to RS images. Multispectral (MS) images play an essential role in scene classification as they contain richer spectral information than red, green, blue (RGB) images. However, MS images are not always available due to the higher cost and complexity of MS sensors compared to RGB sensors. To improve scene classification performance using only RGB images, in this letter, we propose a novel MS-to-RGB knowledge distillation (MS2RGB-KD) framework that transfers MS knowledge from a teacher model to a student model. Specifically, our MS2RGB-KD drives a student model that requires only an RGB image as input to mimic the feature representations of different modalities extracted by the teacher model. Moreover, we introduce novel loss functions that encourage the student model to preserve intramodal and intermodal relationships of the feature representations in the teacher model. Experiments on the EuroSAT dataset demonstrate the effectiveness of MS2RGB-KD compared with other KD baselines.},
	language = {en},
	urldate = {2025-06-23},
	journal = {IEEE Geoscience and Remote Sensing Letters},
	author = {Shin, Hong-Kyu and Uhm, Kwang-Hyun and Jung, Seung-Won and Ko, Sung-Jea},
	year = {2023},
	note = {Read\_Status: In Progress
Read\_Status\_Date: 2025-06-19T10:58:12.484Z
TLDR: A novel MS-to-RGB knowledge distillation (MS2RGB-KD) framework that transfers MS knowledge from a teacher model to a student model that requires only an RGB image as input to mimic the feature representations of different modalities extracted by the teacher model is proposed.},
	keywords = {/important, Correlation, Data mining, Feature extraction, Image analysis, Knowledge distillation (KD), Metadata Updated, multispectral (MS) image, Predictive models, Remote sensing, scene classification, Task analysis, Via Zotero Translator},
	pages = {1--5},
